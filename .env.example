# Copy to .env (repository root). Real environment variables take precedence over this file.
# Every variable below is read by the code; unset ones fall back to the defaults shown.

# --- App -------------------------------------------------------------------
ENVIRONMENT=development            # "production" enforces a non-default GATEWAY_JWT_SECRET
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SEED_DEMO_DATA=false               # true: also insert synthetic sample tickets and audit history

# --- Groq LLM (required to run the agent workflow) -------------------------
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MAX_TOKENS=4096
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=3

# --- Database --------------------------------------------------------------
# Falls back to a local SQLite file (backend/resolveops.db) when PostgreSQL is unreachable.
DATABASE_URL=postgresql://resolveops:resolveops@localhost:5432/resolveops
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Optional services -----------------------------------------------------
REDIS_URL=redis://localhost:6379/0     # only used by /ready
QDRANT_URL=http://localhost:6333       # falls back to an in-memory index when unreachable
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Policy gateway --------------------------------------------------------
GATEWAY_JWT_SECRET=dev-secret-change-in-production
MAX_TOOL_CALLS_PER_RUN=20
# POLICY_FILE=policy/rules.yaml        # override the policy rules file

# --- Inbound webhooks ------------------------------------------------------
# When empty, unsigned webhook requests are accepted in development only.
ZENDESK_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Mock backend services (FastAPI apps in services/mocks) ----------------
MOCK_TICKETING_URL=http://localhost:8001
MOCK_CRM_URL=http://localhost:8002
MOCK_BILLING_URL=http://localhost:8003
BILLING_ERROR_RATE=0.1                 # share of billing-mock calls that fail
BILLING_TIMEOUT_SIMULATION=false
ENABLE_FAULT_INJECTION=false           # in-process billing MCP server fault injection
