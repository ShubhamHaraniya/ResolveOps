# ─── Groq LLM ───────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MAX_TOKENS=4096
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=3

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://resolveops:resolveops@localhost:5432/resolveops
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Qdrant ──────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=resolveops_policies

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Langfuse ────────────────────────────────────────────────
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ─── App ─────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ─── Mock System URLs ────────────────────────────────────────
MOCK_TICKETING_URL=http://localhost:8001
MOCK_CRM_URL=http://localhost:8002
MOCK_BILLING_URL=http://localhost:8003
MOCK_IAM_URL=http://localhost:8004

# ─── Rate / Budget limits ────────────────────────────────────
MAX_TOOL_CALLS_PER_RUN=20
MAX_LLM_CALLS_PER_RUN=10
MAX_REPLANS_PER_RUN=2

# ─── RAG ─────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_FALLBACK_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=20
RAG_RERANK_TOP_N=5

# ─── Billing Mock Simulation ─────────────────────────────────
BILLING_ERROR_RATE=0.1
BILLING_TIMEOUT_SIMULATION=false
